{
  "properties": {
    "workflow_details": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Workflow Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Workflow Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "description": "Add information that will help to differentiate this workflow from another.",
      "title": "Set Workflow Details"
    },
    "er_client": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/EarthRangerConnection",
          "title": "",
          "description": "Select one of your configured data sources."
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Data Source"
    },
    "base_maps": {
      "additionalProperties": false,
      "properties": {
        "base_maps": {
          "default": [
            {
              "url": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",
              "opacity": 1,
              "max_zoom": 20,
              "min_zoom": 0
            },
            {
              "url": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
              "opacity": 0.5,
              "max_zoom": 20,
              "min_zoom": 0
            }
          ],
          "items": {
            "title": "Base Layer",
            "anyOf": [
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
                    "enum": [
                      "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Open Street Map",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Roadmap",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Satellite",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Terrain",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/arcgis/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/arcgis/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/arcgis/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "USGS Hillshade",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://example.tiles.com/{z}/{x}/{y}.png",
                    "description": "The URL of a publicly accessible tiled raster service.",
                    "pattern": "https?:\\/\\/(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}([-a-zA-Z0-9()@:%_\\+.~#?&//=\\{\\}]*)",
                    "title": "Custom Layer URL",
                    "type": "string"
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Custom Layer Opacity",
                    "type": "number"
                  },
                  "max_zoom": {
                    "default": 20,
                    "description": "Set the maximum zoom level to fetch tiles for.",
                    "title": "Custom Layer Max Zoom",
                    "type": "integer"
                  },
                  "min_zoom": {
                    "default": 0,
                    "description": "Set the minimum zoom level to fetch tiles for.",
                    "title": "Custom Layer Min Zoom",
                    "type": "integer"
                  }
                },
                "title": "Custom Layer (Advanced)",
                "type": "object"
              }
            ]
          },
          "title": " ",
          "type": "array",
          "description": "Select tile layers to use as base layers in map outputs. The first layer in the list will be the bottommost layer displayed.",
          "ecoscope:advanced": true
        }
      },
      "type": "object",
      "required": [],
      "title": "Define Base Maps"
    },
    "serial_no": {
      "additionalProperties": false,
      "properties": {
        "var": {
          "title": "Event Serial Number",
          "type": "string",
          "description": "Enter the serial number of the event to retrieve (e.g. 1234)."
        }
      },
      "required": [
        "var"
      ],
      "type": "object",
      "title": "Get Event Serial No."
    },
    "time_range": {
      "additionalProperties": false,
      "properties": {
        "since": {
          "format": "date-time",
          "title": "Since",
          "type": "string",
          "description": "The start time"
        },
        "until": {
          "format": "date-time",
          "title": "Until",
          "type": "string",
          "description": "The end time"
        },
        "timezone": {
          "allOf": [
            {
              "$ref": "#/$defs/TimezoneInfo"
            }
          ],
          "default": null,
          "title": "Timezone"
        }
      },
      "required": [
        "since",
        "until"
      ],
      "type": "object",
      "description": "Choose the period of time to analyze.",
      "title": "Time Range"
    },
    "events": {
      "additionalProperties": false,
      "properties": {
        "event_states": {
          "default": null,
          "items": {
            "type": "string",
            "oneOf": [
              {
                "const": "new",
                "title": "New"
              },
              {
                "const": "active",
                "title": "Active"
              },
              {
                "const": "resolved",
                "title": "Resolved"
              },
              {
                "const": "review",
                "title": "Review"
              }
            ]
          },
          "title": "Event State",
          "type": "array",
          "description": "Choose to analyze events with a certain state. If left empty, events of all states will be analyzed",
          "uniqueItems": true,
          "ecoscope:advanced": true
        },
        "force_point_geometry": {
          "default": true,
          "title": "Force Point Geometry",
          "type": "boolean",
          "description": "If True, polygon/multipolygon event geometries are reduced to their centroid. Set False to preserve native geometry types.",
          "ecoscope:advanced": true
        }
      },
      "required": [],
      "type": "object",
      "title": "All Events"
    },
    "processed_event_details": {
      "additionalProperties": false,
      "properties": {
        "map_to_titles": {
          "default": true,
          "title": "Use Field Titles",
          "type": "boolean",
          "description": "Set to true when the Jinja template references field titles (human-readable labels); set to false when it references raw field keys."
        }
      },
      "required": [],
      "type": "object",
      "title": "Process Event Details"
    },
    "Spatial Features": {
      "type": "object",
      "description": "Fetch spatial features from EarthRanger and render them as a map layer.",
      "ecoscope:task_group": true,
      "properties": {
        "spatial_features": {
          "additionalProperties": false,
          "properties": {
            "source": {
              "allOf": [
                {
                  "$ref": "#/$defs/EarthRangerSource"
                }
              ],
              "default": {
                "query": null
              },
              "title": "Source"
            },
            "group_by": {
              "default": "type_name",
              "title": "Group By",
              "type": "string",
              "description": "Column used to group features in the map legend e.g. 'Feature Type' shows one legend entry per feature type.",
              "oneOf": [
                {
                  "const": "type_name",
                  "title": "Feature Type"
                },
                {
                  "const": "title",
                  "title": "Feature Name"
                }
              ],
              "ecoscope:advanced": true
            },
            "legend_title": {
              "default": "",
              "title": "Legend Title",
              "type": "string",
              "description": "Label shown in the map legend e.g. 'Park Boundary'.",
              "ecoscope:advanced": true
            }
          },
          "required": [],
          "type": "object",
          "title": ""
        }
      }
    },
    "Local Spatial Features": {
      "type": "object",
      "description": "Load spatial features from a local file and render them as a map layer.",
      "ecoscope:task_group": true,
      "properties": {
        "local_spatial_file": {
          "additionalProperties": false,
          "properties": {
            "file_path": {
              "default": "",
              "title": "File Path",
              "type": "string",
              "description": "Path to the geospatial file. Supported formats: GeoJSON (.geojson), GeoPackage (.gpkg), and GeoParquet (.parquet / .geoparquet).",
              "ecoscope:advanced": true
            },
            "layer": {
              "default": "",
              "title": "Layer",
              "type": "string",
              "description": "Layer name within a GeoPackage file. Only required when the file contains multiple layers.",
              "ecoscope:advanced": true
            },
            "group_by": {
              "default": "",
              "title": "Group By",
              "type": "string",
              "description": "Column used to group features in the map legend e.g. 'name', 'category'.",
              "ecoscope:advanced": true
            },
            "legend_title": {
              "default": "",
              "title": "Legend Title",
              "type": "string",
              "description": "Label shown in the map legend e.g. 'Park Boundary'.",
              "ecoscope:advanced": true
            },
            "style": {
              "default": null,
              "items": {
                "$ref": "#/$defs/LayerStyle"
              },
              "maxLength": 1,
              "title": "Style",
              "type": "array",
              "description": "Optional: Customise how features are rendered on the map.",
              "ecoscope:advanced": true
            }
          },
          "type": "object",
          "required": [],
          "title": ""
        }
      }
    },
    "Event Scatterplot Map": {
      "type": "object",
      "description": "Create a scatterplot map of events.",
      "ecoscope:task_group": true,
      "properties": {
        "event_scatterplot_layer": {
          "additionalProperties": false,
          "properties": {
            "tooltip_columns": {
              "default": null,
              "items": {
                "type": "string"
              },
              "title": "Tooltip Columns",
              "type": "array",
              "description": "Restrict the on-hover tooltip to these column names. None (default) shows all properties.",
              "ecoscope:advanced": true
            }
          },
          "type": "object",
          "required": [],
          "title": ""
        },
        "event_map_view_state": {
          "additionalProperties": false,
          "properties": {
            "max_zoom": {
              "default": 20,
              "title": "Max Zoom",
              "type": "number"
            }
          },
          "required": [],
          "type": "object",
          "title": ""
        }
      }
    },
    "Report Generation": {
      "type": "object",
      "description": "Generate the event report including attachments.",
      "ecoscope:task_group": true,
      "properties": {
        "get_template_path": {
          "additionalProperties": false,
          "properties": {
            "var": {
              "title": "Template File Path",
              "type": "string",
              "description": "Path to the Word (.docx) report template file."
            }
          },
          "required": [
            "var"
          ],
          "type": "object",
          "title": ""
        },
        "download_attachments": {
          "additionalProperties": false,
          "properties": {
            "skip_download": {
              "default": false,
              "title": "Skip Attachments",
              "type": "boolean",
              "description": "Set to true to skip downloading attachments."
            }
          },
          "required": [],
          "type": "object",
          "title": "Download Attachments"
        }
      }
    }
  },
  "$defs": {
    "EarthRangerConnection": {
      "properties": {
        "name": {
          "title": "Data Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "EarthRangerConnection",
      "type": "object"
    },
    "TimezoneInfo": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tzCode": {
          "title": "Tzcode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "utc": {
          "title": "Utc",
          "type": "string"
        }
      },
      "required": [
        "label",
        "tzCode",
        "name",
        "utc"
      ],
      "title": "TimezoneInfo",
      "type": "object"
    },
    "EarthRangerSource": {
      "title": "EarthRanger",
      "type": "object",
      "properties": {
        "query": {
          "title": "Query",
          "default": null,
          "anyOf": [
            {
              "type": "null",
              "title": "--- select ---"
            },
            {
              "$ref": "#/$defs/FeatureSetQuery"
            },
            {
              "$ref": "#/$defs/FeatureTypeQuery"
            },
            {
              "$ref": "#/$defs/FeatureIdQuery"
            }
          ]
        }
      }
    },
    "FeatureIdQuery": {
      "description": "Load a single spatial feature by its EarthRanger UUID.",
      "properties": {
        "feature_id": {
          "description": "UUID of a specific spatial feature available on EarthRanger.",
          "title": "Feature Id",
          "type": "string"
        },
        "style": {
          "default": [],
          "description": "Optional: Override how EarthRanger spatial features are rendered on the map. If not specified, features will use their native EarthRanger colours and styling.",
          "items": {
            "$ref": "#/$defs/LayerStyle"
          },
          "maxItems": 1,
          "title": "Style",
          "type": "array"
        }
      },
      "required": [
        "feature_id"
      ],
      "title": "Feature ID",
      "type": "object"
    },
    "FeatureSetQuery": {
      "description": "Load all features from a named EarthRanger featureset.",
      "properties": {
        "featureset_name": {
          "description": "Display name of the featureset exactly as it appears in EarthRanger e.g. 'Boundaries'.",
          "minLength": 1,
          "title": "Featureset Name",
          "type": "string"
        }
      },
      "required": [
        "featureset_name"
      ],
      "title": "Feature Set",
      "type": "object"
    },
    "FeatureTypeQuery": {
      "description": "Load all features of a given type across EarthRanger featuresets.",
      "properties": {
        "feature_type": {
          "description": "Feature type name as shown in EarthRanger e.g. 'Conservancy'.",
          "minLength": 1,
          "title": "Feature Type",
          "type": "string"
        },
        "style": {
          "default": [],
          "description": "Optional: Override how EarthRanger spatial features are rendered on the map. If not specified, features will use their native EarthRanger colours and styling.",
          "items": {
            "$ref": "#/$defs/LayerStyle"
          },
          "maxItems": 1,
          "title": "Style",
          "type": "array"
        }
      },
      "required": [
        "feature_type"
      ],
      "title": "Feature Type",
      "type": "object"
    },
    "LayerStyle": {
      "properties": {
        "polygon": {
          "default": [],
          "description": "Polygon styling. Add one entry to override ER native colours.",
          "items": {
            "$ref": "#/$defs/PolygonStyle"
          },
          "maxItems": 1,
          "title": "Polygon",
          "type": "array"
        },
        "line": {
          "default": [],
          "description": "Line styling. Add one entry to override ER native colours.",
          "items": {
            "$ref": "#/$defs/LineStyle"
          },
          "maxItems": 1,
          "title": "Line",
          "type": "array"
        },
        "point": {
          "default": [],
          "description": "Point and icon marker styling. Add one entry to override ER native colours.",
          "items": {
            "$ref": "#/$defs/PointStyle"
          },
          "maxItems": 1,
          "title": "Point",
          "type": "array"
        }
      },
      "title": "",
      "type": "object"
    },
    "LineStyle": {
      "properties": {
        "color": {
          "default": [],
          "description": "Line hex colour(s) e.g. ['#E63946']. Cycles across rows.",
          "items": {
            "type": "string"
          },
          "title": "Color",
          "type": "array"
        },
        "opacity": {
          "default": 1.0,
          "description": "Line opacity 0\u20131.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Opacity",
          "type": "number"
        },
        "width": {
          "default": 2.0,
          "description": "Line width in pixels.",
          "title": "Width",
          "type": "number"
        }
      },
      "title": "",
      "type": "object"
    },
    "PointStyle": {
      "properties": {
        "color": {
          "default": [],
          "description": "Fill hex colour(s). For SVG icons this tints the marker. Cycles across rows.",
          "items": {
            "type": "string"
          },
          "title": "Color",
          "type": "array"
        },
        "size": {
          "default": null,
          "description": "Point radius / icon size in pixels. Leave empty to use the size set in EarthRanger.",
          "title": "Size",
          "type": "number"
        }
      },
      "title": "",
      "type": "object"
    },
    "PolygonStyle": {
      "properties": {
        "fill_color": {
          "default": [],
          "description": "Fill hex colour(s) e.g. ['#FFA500']. Cycles across rows.",
          "items": {
            "type": "string"
          },
          "title": "Fill Color",
          "type": "array"
        },
        "stroke_color": {
          "default": null,
          "description": "Border hex colour.",
          "title": "Stroke Color",
          "type": "string"
        },
        "fill_opacity": {
          "default": 1.0,
          "description": "Fill opacity 0\u20131.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Fill Opacity",
          "type": "number"
        },
        "stroke_width": {
          "default": 2.0,
          "description": "Border width in pixels.",
          "title": "Stroke Width",
          "type": "number"
        }
      },
      "title": "",
      "type": "object"
    }
  },
  "uiSchema": {
    "workflow_details": {
      "ui:order": [
        "name",
        "description"
      ]
    },
    "time_range": {
      "ui:order": [
        "since",
        "until",
        "timezone"
      ]
    },
    "events": {
      "ui:order": [
        "event_states",
        "force_point_geometry"
      ]
    },
    "Spatial Features": {
      "spatial_features": {
        "ui:order": [
          "source",
          "group_by",
          "legend_title"
        ],
        "source": {
          "ui:options": {
            "label": false
          },
          "query": {
            "ui:options": {
              "label": false
            },
            "anyOf": [
              {
                "ui:options": {
                  "label": false
                }
              },
              {
                "ui:options": {
                  "label": false
                }
              },
              {
                "ui:options": {
                  "label": false
                }
              }
            ]
          }
        },
        "legend_title": {
          "ui:placeholder": "e.g. Park Boundary"
        }
      }
    },
    "Local Spatial Features": {
      "local_spatial_file": {
        "ui:order": [
          "file_path",
          "layer",
          "group_by",
          "legend_title",
          "style"
        ]
      }
    },
    "Event Scatterplot Map": {
      "ui:order": [
        "event_scatterplot_layer",
        "event_map_view_state"
      ]
    },
    "Report Generation": {
      "ui:order": [
        "get_template_path",
        "download_attachments"
      ]
    },
    "ui:order": [
      "workflow_details",
      "er_client",
      "base_maps",
      "serial_no",
      "time_range",
      "events",
      "processed_event_details",
      "Spatial Features",
      "Local Spatial Features",
      "Event Scatterplot Map",
      "Report Generation"
    ]
  },
  "additionalProperties": false
}
